{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist/rebolsys-frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://inf-qualifications-subsequently-zshops.trycloudflare.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
