{
  "info": {
    "name": "REBOLSYS - Sesión y validaciones sin crear operaciones",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requiere JWT de una cuenta activa con permisos para las operaciones verificadas. No crea usuarios ni inicia sesiones automáticas."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "rebolsysJwt",
      "value": "",
      "description": "JWT de REBOLSYS, solo para el entorno local de Postman. No guardar valores reales en Git."
    }
  ],
  "item": [
    {
      "name": "Usuario autenticado actual",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/sesion/actual",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const s=pm.response.json();pm.test(\"Usuario autenticado y permisos vigentes\",()=>{pm.expect(s.idUsuario).to.be.above(0);pm.expect(s.usuario).to.be.a(\"string\");pm.expect(s.modo).to.eql(\"ACTIVA\");pm.expect(s.roles).to.be.an(\"array\");pm.expect(s.permisos).to.be.an(\"array\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "Rechazar otra identidad antes de una venta",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/ventas/confirmadas",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"idUsuario\":999999,\"claveRegistro\":\"validacion-sesion-no-crear\",\"modalidadCobro\":\"SEPARADA\",\"detalles\":[]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Otro usuario rechazado\",()=>pm.response.to.have.status(409));",
              "pm.test(\"Mensaje de sesión\",()=>pm.expect(pm.response.json().message).to.include(\"sesión actual\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Usuario automático antes de validar líneas vacías",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/ventas/confirmadas",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"claveRegistro\":\"validacion-sesion-no-crear\",\"modalidadCobro\":\"SEPARADA\",\"detalles\":[]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Contenido inválido rechazado\",()=>pm.response.to.have.status(400));",
              "pm.test(\"La validación ya no reclama usuario nulo\",()=>{const e=pm.response.json().validationErrors;pm.expect(e).not.to.have.property(\"idUsuario\");pm.expect(e).to.have.property(\"detalles\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "Contrato de sesión y venta",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v3/api-docs",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const s=pm.response.json();pm.test(\"Sesión publicada\",()=>pm.expect(s.paths).to.have.property(\"/api/v1/sesion/actual\"));",
              "pm.test(\"Precio esperado disponible\",()=>pm.expect(s.components.schemas.VentaLineaRegistroDTO.properties).to.have.property(\"precioEsperado\"));"
            ]
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// rebolsys.jwt.bearer: limita la credencial a la API configurada.",
          "const jwt = pm.variables.get(\"rebolsysJwt\");",
          "const base = pm.variables.replaceIn(pm.variables.get(\"baseUrl\") || \"\").replace(/\\/$/, \"\");",
          "const destino = pm.variables.replaceIn(pm.request.url.toString());",
          "if (jwt && base && destino.startsWith(base + \"/api/v1/\")) pm.request.headers.upsert({key:\"Authorization\",value:\"Bearer \"+jwt});"
        ]
      }
    }
  ]
}
