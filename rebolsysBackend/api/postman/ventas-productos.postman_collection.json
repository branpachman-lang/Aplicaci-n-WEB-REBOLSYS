          "raw": "{\n  \"persona\": {\n    \"idTipoDocumento\": \"{{idDni}}\",\n    \"numeroDocumento\": \"{{dni}}\",\n    \"empresa\": false,\n    \"nombres\": \"Cliente\",\n    \"apellidos\": \"Prueba de venta\",\n    \"fechaNacimiento\": \"1990-01-01\"\n  }\n}"
