          }
        ],
        "url": "{{baseUrl}}/api/v1/ventas/confirmadas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"claveRegistro\": \"cero-{{clave}}\",\n  \"idUsuario\": \"{{idUsuario}}\",\n  \"idClienteComprador\": \"{{idCliente}}\",\n  \"modalidadCobro\": \"SEPARADA\",\n  \"detalles\": [\n    {\n      \"idProducto\": \"{{idAgua}}\",\n      \"cantidad\": 0\n    },\n    {\n      \"idProducto\": \"{{idGalletas}}\",\n      \"cantidad\": 1\n    }\n  ],\n  \"cobro\": {\n    \"idFormaPago\": \"{{idFormaPago}}\",\n    \"monto\": 2,\n    \"numeroOperacion\": null\n  }\n}"
