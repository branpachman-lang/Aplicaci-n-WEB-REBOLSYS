# Plantilla de variables: configurar en el IDE o terminal.
# Spring Boot no carga este archivo automáticamente.
# Para usar application-prod.yaml:
SPRING_PROFILES_ACTIVE=prod
DB_URL=
DB_USERNAME=
DB_PASSWORD=
SERVER_PORT=8080
# Comprobantes por SMTP. Guardar la contraseña de aplicación solo en configuración privada.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_SSL=false
# Orígenes exactos del frontend, incluidos los reenviados por Vercel/Cloudflare.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://rebolsys12.vercel.app
# Clave privada Base64 de al menos 32 bytes; obligatoria en producción.
JWT_SECRET=
JWT_DURACION_MAXIMA=8h
JWT_VALIDAR_INSTANCIA=true
JWT_REVOCAR_EN_REDIS=false
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX_POR_MINUTO=30
LOGIN_RATE_LIMIT_VENTANA=1m
# Redis y caché de catálogos (opcional en desarrollo; recomendado en producción).
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_SSL=false
CACHE_ENABLED=true
CACHE_PREFIX=rebolsys:prod:v1:
FLYWAY_ENABLED=false
# Inicialización opcional de cuenta gerente (ambas variables deben ir juntas).
REBOLSYS_GERENTE_USUARIO=
REBOLSYS_GERENTE_PASSWORD_TEMPORAL=
APISPERU_TOKEN=
APISPERU_BASE_URL=https://dniruc.apisperu.com/api/v1
APISPERU_TIMEOUT_MILLIS=8000

# Facturación beta: credencial independiente de consultas DNI/RUC.
# Token de facturación o usuario/password (el backend obtiene y renueva su sesión).
FACTURACION_HABILITADA=false
FACTURACION_APISPERU_URL=https://facturacion.apisperu.com/api/v1
FACTURACION_APISPERU_TOKEN=
FACTURACION_APISPERU_USUARIO=
FACTURACION_APISPERU_PASSWORD=
FACTURACION_APISPERU_ID_EMPRESA=
FACTURACION_EMISOR_RUC=
FACTURACION_EMISOR_RAZON_SOCIAL=
FACTURACION_EMISOR_DIRECCION=
FACTURACION_EMISOR_UBIGEO=
FACTURACION_EMISOR_DEPARTAMENTO=
FACTURACION_EMISOR_PROVINCIA=
FACTURACION_EMISOR_DISTRITO=
FACTURACION_TIMEOUT_MILLIS=8000

# Yape vía Mercado Pago (Checkout API Orders) o simulador local.
# Requiere aplicar V23__pago_yape.sql en el esquema Oracle.
YAPE_HABILITADO=true
YAPE_MODO=SIMULADO
YAPE_MP_AMBIENTE=PRUEBA
MP_YAPE_PUBLIC_KEY=
MP_YAPE_ACCESS_TOKEN=
MP_YAPE_SELLER_ID=
MP_YAPE_WEBHOOK_SECRET=
MP_YAPE_PAYER_EMAIL=pagos-yape@rebolsys.local
